{
  "manifest_version": 3,
  "name": "PulseShare - Rede P2P Serverless & Link WebRTC",
  "version": "3.0.0",
  "description": "Transferência 100% P2P sem servidor para arquivos grandes (+100MB / +1GB) via WebRTC DataChannel, malha MQTT e Link Público direto.",
  "permissions": [
    "storage",
    "downloads",
    "downloads.open",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "wss://broker.emqx.io/*",
    "wss://broker.hivemq.com/*",
    "wss://test.mosquitto.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PulseShare P2P"
  },
  "web_accessible_resources": [
    {
      "resources": ["receiver.html", "receiver.js", "tailwind.css", "fflate.min.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
